
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  username     String? @unique
  email        String? @unique
  passwordHash String?
  refreshToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  balance Balance?

  orders Order[]

  positions Position[]

  makerFills Fill[] @relation("maker_user")
  takerFills Fill[] @relation("taker_user")

  ledgerEntries LedgerEntry[]
}

model Balance {
  id String @id @default(cuid())

  userId String @unique

  availableMargin Decimal @db.Decimal(20, 8)
  lockedMargin    Decimal @db.Decimal(20, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model LedgerEntry {
  id String @id @default(cuid())

  userId String

  type   LedgerEntryType
  amount Decimal         @db.Decimal(20, 8)

  seq BigInt @default(autoincrement())

  status LedgerStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Market {
  id String @id @default(cuid())

  symbol     String @unique
  baseAsset  String
  quoteAsset String

  imageUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickSize              Decimal
  lotSize               Decimal
  minQty                BigInt
  maxLeverage           Int
  maintenanceMarginRate BigInt
  takerFeeBps           Int     @default(0)
  makerFeeBps           Int     @default(0)

  orders        Order[]
  positions     Position[]
  fundingRates  FundingRate[]
  fills         Fill[]
  insuranceFund InsuranceFund?
}

model Order {
  id String @id @default(cuid())

  userId   String
  marketId String

  side      TradeSide
  orderType OrderType

  price    Decimal? @db.Decimal(20, 8)
  quantity Decimal  @db.Decimal(20, 8)

  seq BigInt @default(autoincrement())

  leverage Int

  filledQuantity Decimal @default(0) @db.Decimal(20, 8)

  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  market Market @relation(fields: [marketId], references: [id])

  makerFills Fill[] @relation("maker_order")
  takerFills Fill[] @relation("taker_order")

  @@index([status, seq])
}

model Fill {
  id String @id @default(cuid())

  marketId String

  makerUserId String
  takerUserId String

  makerOrderId String
  takerOrderId String

  quantity Decimal @db.Decimal(20, 8)
  price    Decimal @db.Decimal(20, 8)

  createdAt DateTime @default(now())

  makerUser User @relation("maker_user", fields: [makerUserId], references: [id])
  takerUser User @relation("taker_user", fields: [takerUserId], references: [id])

  makerOrder Order @relation("maker_order", fields: [makerOrderId], references: [id])
  takerOrder Order @relation("taker_order", fields: [takerOrderId], references: [id])

  market Market @relation(fields: [marketId], references: [id])

  @@index([marketId])
}

model Position {
  id String @id @default(cuid())

  userId   String
  marketId String

  size Decimal @db.Decimal(20, 8)

  entryPrice Decimal @db.Decimal(20, 8)

  liquidationPrice Decimal @db.Decimal(20, 8)

  leverage Int

  margin Decimal @db.Decimal(20, 8)

  unrealizedPnl Decimal @default(0) @db.Decimal(20, 8)

  realizedPnl Decimal @default(0) @db.Decimal(20, 8)

  status PositionStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  market Market @relation(fields: [marketId], references: [id])

  @@unique([userId, marketId])
}

model FundingRate {
  id String @id @default(cuid())

  marketId String

  rate Decimal @db.Decimal(20, 8)

  fundingTime DateTime

  createdAt DateTime @default(now())

  market Market @relation(fields: [marketId], references: [id])

  @@index([marketId, fundingTime])
}

model Depth {
  id String @id

  bids Json
  asks Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InsuranceFund {
  id String @id @default(cuid())

  marketId String @unique

  balance Decimal @default(0) @db.Decimal(30, 8)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  market Market @relation(fields: [marketId], references: [id])
}

model Journal {
  id String @id @default(cuid())

  seq BigInt @default(autoincrement())

  userId   String?
  marketId String?

  account JournalAccount
  delta   Decimal        @db.Decimal(30, 8)

  refType String
  refId   String

  createdAt DateTime @default(now())

  @@index([userId, seq])
  @@index([refType, refId])
}

model CommandOutbox {
  seq BigInt @id @default(autoincrement())

  commandId String @unique

  marketId String

  type    String
  payload Json

  status OutboxStatus @default(PENDING)

  createdAt DateTime @default(now())
  relayedAt DateTime?

  @@index([status, seq])
}

enum PositionStatus {
  OPEN
  CLOSED
  LIQUIDATED
}

enum TradeSide {
  LONG
  SHORT
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderStatus {
  PENDING
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
  EXPIRED
}

enum LedgerEntryType {
  DEPOSIT
  WITHDRAW
}

enum LedgerStatus {
  PENDING
  APPLIED
  REJECTED
}

enum JournalAccount {
  AVAILABLE
  LOCKED
  INSURANCE
  PNL
  FEE
  FUNDING
}

enum OutboxStatus {
  PENDING
  RELAYED
}
