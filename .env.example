# Copy to .env and fill in. .env is git-ignored and never committed.
# docker-compose.yml interpolates these; required secrets fail fast if unset.

# --- Required secrets (no safe default) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_KEY=
# Must match the market id created by the seed (packages/db/prisma/seed.ts).
MARKET_ID=

# --- Optional overrides (sensible dev defaults applied if omitted) ---
# POSTGRES_PASSWORD=perps
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
