# Persistence consumer (EVENT_QUEUE -> Postgres read model). Copy to `.env`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
DATABASE_URL="postgresql://perps:perps@localhost:5432/perps"

# S3 (LocalStack in dev). Present for parity; persistence is Postgres-first.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=perps-events
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
