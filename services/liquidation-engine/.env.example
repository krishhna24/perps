# Liquidation engine. Copy to `.env`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Base URL of the HTTP API the liquidation worker POSTs to.
API_URL=http://localhost:3000

# Shared secret for the trusted liquidation hop. Must match apps/server.
INTERNAL_SERVICE_KEY=dev-internal-service-key

# Demo market id. Must match the seeded market and the engine.
MARKET_ID=cmqgd206q00002bxy0wavuaff
