# Matching engine. Copy to `.env`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
DATABASE_URL="postgresql://perps:perps@localhost:5432/perps"

# S3 (LocalStack in dev) for engine state snapshots. The engine creates the
# bucket on boot if missing. Leave S3_* unset to run without snapshot recovery.
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=perps-engine
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# S3 object key for this engine's snapshot.
ENGINE_KEY=engine-snapshot.json
