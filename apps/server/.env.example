# HTTP API server. Copy to `.env` and adjust for your environment.
PORT=3000

# Auth secrets — any non-empty value works for local dev; use strong random
# values in a real deployment. JWT_SECRET must match the websocket service.
JWT_SECRET=dev-jwt-secret-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me

# Shared secret for the trusted service-to-service liquidation hop.
# Must match services/liquidation-engine.
INTERNAL_SERVICE_KEY=dev-internal-service-key

# Infra (matches docker-compose defaults).
REDIS_HOST=localhost
REDIS_PORT=6379
DATABASE_URL="postgresql://perps:perps@localhost:5432/perps"
