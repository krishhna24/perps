{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DATABASE_URL",
    "REDIS_HOST",
    "REDIS_PORT",
    "ENGINE_KEY",
    "S3_ENDPOINT",
    "S3_BUCKET",
    "AWS_REGION",
    "AWS_ACCESS_KEY_ID",
    "AWS_SECRET_ACCESS_KEY",
    "API_URL",
    "INTERNAL_SERVICE_KEY",
    "MARKET_ID",
    "LOG_LEVEL",
    "NODE_ENV",
    "CORS_ORIGIN",
    "PORT",
    "HEALTH_PORT",
    "WS_MAX_PAYLOAD_BYTES",
    "WS_ALLOWED_ORIGINS",
    "WS_HEARTBEAT_INTERVAL_MS",
    "WS_MAX_CONNECTIONS_PER_IP",
    "JWT_SECRET",
    "JWT_REFRESH_SECRET",
    "JWT_EXPIRES_IN",
    "JWT_REFRESH_EXPIRES_IN",
    "WS_TICKET_TTL_S",
    "REFRESH_COOKIE_MAX_AGE_MS",
    "RATE_LIMIT_WINDOW_MS",
    "RATE_LIMIT_MAX",
    "AUTH_RATE_LIMIT_WINDOW_MS",
    "AUTH_RATE_LIMIT_MAX",
    "LOGIN_MAX_FAILURES",
    "LOGIN_LOCKOUT_MS",
    "INTERNAL_MAX_SKEW_MS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**", "generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    }
  }
}
