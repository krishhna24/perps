# Production configuration for docker-compose.prod.yml.
#
#   cp .env.production.example .env.production
#   # fill in every value below, then:
#   docker compose --env-file .env.production -f docker-compose.prod.yml up -d
#
# .env.production is git-ignored and must never be committed. Every value here is
# required: compose uses the `:?` form, so a missing one fails the stack immediately
# with a named error rather than starting a service in a broken state.

# ---------------------------------------------------------------- images ------
# Digests, not tags. Copy these from the CI run summary, which prints one per image.
# A tag can be repointed; a digest cannot, so this is what makes a deploy reproducible
# and a rollback possible (redeploy the previous digest).
BACKEND_DIGEST=sha256:
WEB_DIGEST=sha256:
MIGRATE_DIGEST=sha256:

# --------------------------------------------------------------- secrets ------
# Generate each independently — never reuse one across variables:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
INTERNAL_SERVICE_KEY=
POSTGRES_PASSWORD=

# --------------------------------------------------------------- hostname -----
# The public origin the browser loads the trading terminal from. Used for the API's
# CORS allowlist and the WebSocket gateway's origin allowlist — the gateway accepts
# all origins if this is unset, which is a dev-only default.
# No trailing slash.
PUBLIC_WEB_ORIGIN=https://perps.example.com

# ------------------------------------------------------- object storage -------
# Cloudflare R2, S3-compatible. Create the two buckets below and an API token scoped
# to them. Off-host on purpose: losing the VM still leaves the engine's snapshot — the
# only thing it recovers from — intact.
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ENGINE_BUCKET=perps-engine
EVENTS_BUCKET=perps-events

# ---------------------------------------------------------------- market ------
# Must match the market the seed creates. The engine reads this market's
# maintenanceMarginRate at boot to price liquidations; if it cannot find the row it
# logs a warning and falls back to 5%, so a wrong value here is quiet, not loud.
MARKET_ID=

# ---------------------------------------------------------------- ingress -----
# From the Cloudflare dashboard: Zero Trust → Networks → Tunnels → your tunnel.
# The tunnel dials outbound, so the host needs no inbound firewall rule for HTTP.
CLOUDFLARE_TUNNEL_TOKEN=

# ==============================================================================
# NOT SET HERE — and this is the one that will catch you out.
#
# NEXT_PUBLIC_API_URL and NEXT_PUBLIC_WS_URL are inlined into the browser bundle
# when the web image is *built*, so setting them at runtime does nothing. The web
# image is bound to the origins it was built for.
#
# Set them as GitHub repository variables (Settings → Secrets and variables →
# Actions → Variables) before the image build:
#
#   NEXT_PUBLIC_API_URL = https://api.perps.example.com
#   NEXT_PUBLIC_WS_URL  = wss://ws.perps.example.com
#
# Get this wrong and the site loads normally, then silently fails every API call —
# it will look like a backend outage.
# ==============================================================================
